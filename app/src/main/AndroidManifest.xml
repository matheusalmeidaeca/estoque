<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Estoque"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ContagemActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".VerContagemActivity" android:exported="false" />
        <activity android:name=".ItensActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EstatisticasActivity" android:exported="false" />
    </application>

</manifest>
